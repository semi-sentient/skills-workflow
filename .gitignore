# Environment variables
.env

# Logs
logs
*.log
npm-debug.log*

# Build Artifacts
node_modules
build
coverage
dist
*.local
*.tsbuildinfo

# Temp directories
archived/
temp/
.temp/

# Editor directories and files
!.vscode/extensions.json
.DS_Store

# Agent discovery directories — generated, never committed.
# These hold symlinks into the domain folders. Committing them gave the
# `skills` CLI two paths for every skill (the real file and the symlink),
# which made it record the empty-string digest and skip updates entirely.
# Regenerate with ./scripts/register-skill.sh --all after cloning, and after
# any pull that removes them — git deletes the directories, not just the links.
.agents/skills/
.claude/skills/

# Agent research / planning files
.agents/plans
.agents/scratch
.agents/settings.local.json
.claude/plans
.claude/scratch
.claude/settings.local.json


# Eval fixture repos (built outside the repo; this is belt-and-braces)
.skills-evals/
__pycache__/
*.pyc
